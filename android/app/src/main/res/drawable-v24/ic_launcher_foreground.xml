<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shadow/depth layer (offset down-right) -->
    <!-- Note head shadow -->
    <path
        android:pathData="M37,83 C37,75 44,70 53,70 C62,70 68,75 68,82 C68,90 61,94 52,94 C43,94 37,90 37,83 Z"
        android:fillColor="#44000000"/>
    <!-- Stem shadow -->
    <path
        android:pathData="M67,80 L67,31 C67,29 69,29 69,31 L69,80 Z"
        android:fillColor="#44000000"/>
    <!-- Flag shadow -->
    <path
        android:pathData="M67,31 C78,33 86,41 84,52 C82,61 74,65 67,62"
        android:strokeColor="#44000000"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

    <!-- Main note: filled white with gradient shine for 3D look -->
    <!-- Note head -->
    <path android:pathData="M34,80 C34,72 42,67 51,67 C60,67 66,72 66,79 C66,87 59,92 50,92 C41,92 34,88 34,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="67"
                android:endX="66"
                android:endY="92">
                <item android:color="#FFFFFFFF" android:offset="0.0"/>
                <item android:color="#FFD8EEF0" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stem (solid filled rect for crispness) -->
    <path
        android:pathData="M63,77 L63,28 C63,26 67,26 67,28 L67,77 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Flag (flowing curve from top of stem) -->
    <path
        android:pathData="M65,28 C76,30 84,38 82,49 C80,58 72,62 65,59"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Shine highlight on note head -->
    <path
        android:pathData="M44,71 C48,69 55,70 59,73"
        android:strokeColor="#60FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>

</vector>
